# Copy to .env for local development. On Vercel set these in Project Settings -> Environment Variables.
# Never commit real values.

# --- Database (PostgreSQL) ---
# Local dev: `bun run db:dev` starts Postgres on port 54329; use the URL it prints.
# Vercel + Neon: the POOLED connection string (host contains "-pooler").
# Vercel + Supabase: the transaction pooler string (port 6543) with ?pgbouncer=true&connection_limit=1
# Migrations run during `vercel-build`; if they hang on a pooled URL set PRISMA_SCHEMA_DISABLE_ADVISORY_LOCK=1
# or run `prisma migrate deploy` once from your machine against the direct (non-pooled) URL.
DATABASE_URL=

# --- App ---
# Public https URL of the deployment (no trailing slash). Used for auth origin and links.
NEXT_PUBLIC_APP_URL=
# REQUIRED. >= 32 chars. Generate: openssl rand -base64 32
AUTH_SECRET=
# REQUIRED. Protects /api/workers/run (Vercel Cron sends it as "Authorization: Bearer <value>").
# Generate: openssl rand -hex 32
CRON_SECRET=

# --- Branding / support (all optional) ---
NEXT_PUBLIC_APP_NAME=Shree Vishwayog Ayurved
NEXT_PUBLIC_SUPPORT_PHONE=
NEXT_PUBLIC_SUPPORT_EMAIL=
SUPPORT_PHONE=
# Default country code for phone numbers entered without one.
DEFAULT_COUNTRY_CODE=91

# --- Razorpay ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Secret you set on the webhook in the Razorpay dashboard (/api/webhooks/razorpay).
RAZORPAY_WEBHOOK_SECRET=

# --- WhatsApp (Meta Cloud API): reminders + login OTP ---
META_WA_ACCESS_TOKEN=
META_WA_PHONE_NUMBER_ID=
# The login code uses the approved WhatsApp template "verify_account" (en_US), fixed in code.

# --- Google Calendar / Meet (class links) ---
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary

# --- Admin ---
# Comma-separated emails allowed to change the membership price. If empty, the first admin is super admin.
SUPER_ADMIN_EMAILS=

# --- First-admin bootstrap (only for `bun run db:bootstrap`, run locally; not needed on Vercel) ---
BOOTSTRAP_ADMIN_NAME=
BOOTSTRAP_ADMIN_PHONE=
BOOTSTRAP_ADMIN_EMAIL=

# --- Optional self-host worker (mini-services/yoga-worker); not used on Vercel ---
# WORKER_BASE_URL=https://your-domain
# WORKER_PORT=3004

# --- Optional / legacy payment gateways: only if enabled in the app ---
# RAZORPAY_PLAN_ID=
# ENABLE_PAYMENT_BRIDGE=
# CASHFREE_SECRET_KEY=
# PHONEPE_WEBHOOK_USERNAME=
# PHONEPE_WEBHOOK_PASSWORD=

# --- Dev only: demo seed (refuses to run in production) ---
# SEED_DEMO_PASSWORD=
